{
  "name": "@tetraslam13/computah",
  "version": "0.1.1",
  "description": "An improvements box for your app: type a change, and a coding agent you already have makes it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "computah": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "modal": ">=0.11"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "modal": "^0.11.1",
    "react": "latest",
    "react-dom": "latest",
    "vitest": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetraslam/computah.git",
    "directory": "packages/computah"
  },
  "homepage": "https://computah.tetraslam.world",
  "keywords": [
    "agent",
    "react",
    "improvements",
    "malleable-software",
    "claude-code",
    "codex",
    "opencode"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "modal": {
      "optional": true
    }
  }
}
